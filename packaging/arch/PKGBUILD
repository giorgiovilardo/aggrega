# Builds Aggrega from this local checkout (no download step).
# Usage (from this directory):  makepkg -si
pkgname=aggrega
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast, lightweight, local-first RSS/Atom feed reader (Rust + Slint)"
arch=('x86_64' 'aarch64')
# TODO: pick a license for Aggrega (see "Licensing" in README.md).
license=('LicenseRef-unspecified')
depends=(
  'gcc-libs' 'glibc'
  'fontconfig' 'freetype2'
  'libxkbcommon' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr'
  'libglvnd' 'hicolor-icon-theme'
)
makedepends=('cargo')
options=('!lto' '!debug')

# The project root is two levels above this PKGBUILD.
_root="$(realpath "${startdir:-.}/../..")"

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/aggrega" "$pkgdir/usr/bin/aggrega"
  install -Dm644 "$_root/packaging/aggrega.desktop" "$pkgdir/usr/share/applications/aggrega.desktop"
  install -Dm644 "$_root/assets/aggrega.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aggrega.svg"
}
