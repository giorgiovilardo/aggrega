export struct ArticleItem {
    id: int,
    title: string,
    source: string,
    time: string,
    snippet: string,
    link: string,
    read: bool,
    has-thumb: bool,
    thumb: image,
    image-url: string,
    letter: string,
    tint: color,
    // Set when the row is about to be removed (e.g. read while filtering unread).
    leaving: bool,
}

export struct FeedItem {
    id: int,
    title: string,
    unread: int,
    letter: string,
    tint: color,
    error: bool,
}

export enum BlockKind { paragraph, heading, quote, bullet, code, image }

// One block of an article in the reader view.
export struct ReaderBlock {
    kind: BlockKind,
    text: string,
    // For images: the address (to match async loads) and the pixels once loaded.
    image-url: string,
    image: image,
}

// The article shown in the reader view.
export struct ReaderInfo {
    id: int,
    title: string,
    source: string,
    time: string,
    // Domain of the original page, e.g. "example.com".
    host: string,
    tint: color,
    read: bool,
    lead: image,
}
