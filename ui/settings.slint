import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Fonts } from "theme.slint";
import { GhostButton, IconButton, PrimaryButton } from "widgets.slint";
import { DialogHeader, Modal } from "dialogs.slint";

// One entry in the settings rail, styled like a sidebar row.
component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    height: 40px;
    background: root.selected || touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 160ms; }

    // Red selection rule that grows in from the middle.
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? parent.height : 0px;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        animate height { duration: 280ms; easing: cubic-bezier(0.3, 1.2, 0.5, 1); }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 11px;
        Image {
            source: root.icon;
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.accent : Theme.text-muted;
            animate colorize { duration: 160ms; }
        }
        Text {
            text: root.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            font-family: root.selected ? Fonts.sans-bold : Fonts.sans;
            font-weight: root.selected ? 700 : 500;
            font-size: 13.5px;
            color: root.selected || touch.has-hover ? Theme.ink : Theme.text-muted;
            animate color { duration: 160ms; }
        }
    }
}

// A label / value line in a hairline-ruled table, with an optional action
// link ("Open", "Show folder") at the end.
component FactRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> action;
    // Long unbroken values such as file paths wrap anywhere.
    in property <bool> path: false;
    callback act();

    HorizontalLayout {
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 16px;
        Text {
            width: 120px;
            text: root.label.to-uppercase();
            vertical-alignment: center;
            font-family: Fonts.sans-bold;
            font-weight: 700;
            font-size: 10.5px;
            letter-spacing: 1.4px;
            color: Theme.text-faint;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            vertical-alignment: center;
            wrap: root.path ? char-wrap : word-wrap;
            font-family: root.path ? Fonts.sans : Fonts.serif;
            font-size: root.path ? 13px : 15px;
            color: Theme.ink;
        }
        if root.action != "": Rectangle {
            accessible-role: button;
            accessible-label: root.label + ": " + root.action;
            accessible-action-default => { root.act(); }
            width: link.preferred-width;

            link := Text {
                text: root.action;
                vertical-alignment: center;
                font-family: Fonts.sans-semibold;
                font-weight: 600;
                font-size: 13px;
                color: touch.has-hover ? Theme.accent-strong : Theme.accent;
                animate color { duration: 140ms; }
            }
            // Underline on hover.
            Rectangle {
                y: (parent.height + link.preferred-height) / 2;
                height: 1px;
                background: Theme.accent-strong;
                opacity: touch.has-hover ? 1 : 0;
                animate opacity { duration: 140ms; }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.act(); }
            }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.rule;
    }
}

// Small-caps heading above a block of the About tab.
component SectionKicker inherits Text {
    font-family: Fonts.sans-bold;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 1.4px;
    color: Theme.text-faint;
}

component CreditNote inherits Text {
    wrap: word-wrap;
    font-family: Fonts.serif;
    font-size: 13.5px;
    color: Theme.text-body;
}

// A bordered row: icon, title and description, and a button at the end.
component ActionCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback act();

    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.bg;

    HorizontalLayout {
        padding: 18px;
        spacing: 14px;
        VerticalLayout {
            alignment: start;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: Theme.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.title;
                font-family: Fonts.sans-bold;
                font-weight: 700;
                font-size: 14px;
                color: Theme.ink;
            }
            Text {
                text: root.body;
                wrap: word-wrap;
                font-family: Fonts.serif;
                font-size: 14.5px;
                color: Theme.text-body;
            }
        }
        VerticalLayout {
            alignment: center;
            if root.primary: PrimaryButton {
                text: root.action;
                enabled: root.enabled;
                clicked => { root.act(); }
            }
            if !root.primary: GhostButton {
                text: root.action;
                enabled: root.enabled;
                clicked => { root.act(); }
            }
        }
    }
}

// Moving sources in and out of Aggrega as OPML.
component TransferPane inherits VerticalLayout {
    in property <bool> has-feeds;
    in property <bool> importing;
    callback import-sources();
    callback export-sources();

    padding: 40px;
    padding-top: 38px;
    spacing: 18px;
    alignment: start;

    DialogHeader {
        kicker: "Import & export";
        title: "Take your edition with you";
        subtitle: "Bring your sources over from another feed reader, or save them to a file as a backup.";
        subtitle-color: Theme.text-body;
    }

    ActionCard {
        icon: Icons.download;
        title: "Import from OPML";
        body: "Follow every source in a file exported by another feed reader. Ones you already follow are skipped.";
        action: root.importing ? "Importing…" : "Import…";
        primary: true;
        enabled: !root.importing;
        act => { root.import-sources(); }
    }

    ActionCard {
        icon: Icons.upload;
        title: "Export as OPML";
        body: "The standard subscription list that every feed reader can import.";
        action: "Export…";
        enabled: root.has-feeds;
        act => { root.export-sources(); }
    }
}

component AboutPane inherits VerticalLayout {
    in property <string> version;
    in property <string> repository;
    in property <string> db-path;
    in property <string> thumbs-path;
    callback open-link(string);
    callback open-data-folder(bool);

    padding: 40px;
    padding-top: 38px;
    spacing: 8px;
    alignment: start;

    Text {
        text: "ABOUT";
        font-family: Fonts.sans-black;
        font-weight: 800;
        font-size: 10.5px;
        letter-spacing: 2px;
        color: Theme.accent;
    }
    HorizontalLayout {
        alignment: start;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../assets/aggrega.svg");
                width: 56px;
                height: 56px;
                accessible-label: "Aggrega icon";
            }
        }
        Text {
            text: "Aggrega";
            font-family: Fonts.serif-black;
            font-weight: 900;
            font-size: 52px;
            letter-spacing: -1.5px;
            color: Theme.accent;
        }
    }
    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: 312px;
            height: 2px;
            background: Theme.ink;
        }
    }
    Text {
        text: "YOUR FEEDS · ONE EDITION";
        font-family: Fonts.sans-bold;
        font-weight: 700;
        font-size: 10.5px;
        letter-spacing: 1.6px;
        color: Theme.text-muted;
    }
    Rectangle {
        height: 4px;
    }
    Text {
        text: "A fast, lightweight feed reader for RSS, Atom and JSON Feed. Everything stays on this computer: no account, no cloud, no tracking. Aggrega only goes online to fetch your sources, their pictures and the articles you open.";
        wrap: word-wrap;
        font-family: Fonts.serif;
        font-size: 15.5px;
        color: Theme.text-body;
    }
    VerticalLayout {
        padding-top: 18px;
        Rectangle {
            height: 1px;
            background: Theme.rule;
        }
        if root.version != "": FactRow {
            label: "Version";
            value: root.version;
        }
        FactRow {
            label: "Copyright";
            value: "© 2026 Salvatore Laisa";
        }
        FactRow {
            label: "License";
            value: "MIT";
            action: "Read";
            act => { root.open-link(root.repository + "/blob/main/LICENSE"); }
        }
        FactRow {
            label: "Source code";
            value: root.repository;
            action: "Open";
            act => { root.open-link(root.repository); }
        }
        FactRow {
            label: "Issues";
            value: "Report a bug or suggest an idea";
            action: "Open";
            act => { root.open-link(root.repository + "/issues"); }
        }
    }

    // Where the profile lives (README: "Where is my data?").
    VerticalLayout {
        padding-top: 26px;
        spacing: 10px;
        SectionKicker {
            text: "YOUR DATA";
        }
        VerticalLayout {
            Rectangle {
                height: 1px;
                background: Theme.rule;
            }
            FactRow {
                label: "Database";
                value: root.db-path;
                path: true;
                action: "Show folder";
                act => { root.open-data-folder(false); }
            }
            FactRow {
                label: "Thumbnails";
                value: root.thumbs-path;
                path: true;
                action: "Show folder";
                act => { root.open-data-folder(true); }
            }
        }
        CreditNote {
            text: "Sources, articles and settings live in the database. The thumbnail cache is safe to delete; it refills as you browse.";
        }
    }

    // Notices for the bundled third-party software and fonts.
    VerticalLayout {
        padding-top: 26px;
        spacing: 10px;
        SectionKicker {
            text: "CREDITS";
        }
        CreditNote {
            text: "The interface is built with Slint, © SixtyFPS GmbH, used under the Slint Royalty-free Desktop, Mobile, and Web Applications License 2.0.";
        }
        CreditNote {
            text: "Source Serif 4, © 2014–2021 Adobe, with Reserved Font Name “Source”, and Libre Franklin, © 2020 The Libre Franklin Project Authors, are used under the SIL Open Font License 1.1, included with Aggrega as OFL.txt.";
        }
        CreditNote {
            text: "Storage is powered by SQLite, which is in the public domain. Other open-source libraries are used under their own licenses, including MIT, Apache 2.0, BSD, ISC, Zlib, MPL 2.0 and Unicode.";
        }
        // The Slint Royalty-free License asks for the AboutSlint widget in
        // the app's About screen.
        HorizontalLayout {
            padding-top: 8px;
            alignment: center;
            AboutSlint {
                width: 160px;
                height: self.min-height;
            }
        }
    }
}

// Settings: a large modal with a vertical tab rail on the left and the
// selected tab's content on the right.
export component SettingsDialog inherits Rectangle {
    in property <string> version;
    in property <string> repository;
    in property <string> db-path;
    in property <string> thumbs-path;
    in property <bool> has-feeds;
    in property <bool> importing;
    callback closed();
    callback import-sources();
    callback export-sources();
    callback open-link(string);
    callback open-data-folder(bool);

    out property <bool> shown: false;
    in-out property <int> tab: 0;

    public function open() {
        self.shown = true;
    }

    public function close() {
        if (self.shown) {
            self.shown = false;
            self.closed();
        }
    }

    Modal {
        shown: root.shown;
        bare: true;
        card-width: 880px;
        card-height: 600px;
        dismiss => { root.close(); }

        HorizontalLayout {
            // Tab rail.
            Rectangle {
                width: 220px;
                background: Theme.sidebar;
                animate background { duration: 300ms; }

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.rule;
                }

                VerticalLayout {
                    padding-top: 34px;
                    padding-bottom: 20px;
                    spacing: 2px;
                    alignment: start;

                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-bottom: 22px;
                        spacing: 8px;
                        Text {
                            text: "Settings";
                            font-family: Fonts.serif-black;
                            font-weight: 900;
                            font-size: 28px;
                            letter-spacing: -0.4px;
                            color: Theme.ink;
                        }
                        Rectangle {
                            height: 2px;
                            background: Theme.ink;
                        }
                    }

                    SettingsTab {
                        label: "Import & export";
                        icon: Icons.download;
                        selected: root.tab == 0;
                        clicked => { root.tab = 0; }
                    }
                    SettingsTab {
                        label: "About";
                        icon: Icons.info;
                        selected: root.tab == 1;
                        clicked => { root.tab = 1; }
                    }
                }
            }

            // Content of the selected tab, scrolling when it outgrows the card.
            Rectangle {
                horizontal-stretch: 1;

                ScrollView {
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, root.tab == 0 ? transfer-pane.preferred-height : about-pane.preferred-height);

                    transfer-pane := TransferPane {
                        visible: root.tab == 0;
                        width: parent.width;
                        has-feeds: root.has-feeds;
                        importing: root.importing;
                        import-sources => { root.import-sources(); }
                        export-sources => { root.export-sources(); }
                    }
                    about-pane := AboutPane {
                        visible: root.tab == 1;
                        width: parent.width;
                        version: root.version;
                        repository: root.repository;
                        db-path: root.db-path;
                        thumbs-path: root.thumbs-path;
                        open-link(url) => { root.open-link(url); }
                        open-data-folder(thumbs) => { root.open-data-folder(thumbs); }
                    }
                }

                IconButton {
                    x: parent.width - self.width - 14px;
                    y: 16px;
                    icon: Icons.x;
                    label: "Close settings";
                    clicked => { root.close(); }
                }
            }
        }
    }
}
